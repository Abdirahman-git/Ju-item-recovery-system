PORT=5000
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# Server-only: sb_secret_... (API Keys → Secret) OR legacy service_role JWT.
# Never put anon / sb_publishable_ here.
SUPABASE_KEY=your_sb_secret_or_service_role_here

# Real mailbox that SENDS mail (Gmail + App Password). Required for OTP + contact replies.
# Example: yourname@gmail.com
GMAIL_USER=
GMAIL_PASS=

# Optional: where new contact form alerts go (defaults to GMAIL_USER)
CONTACT_INBOX_EMAIL=

# Optional: Reply-To on outbound contact replies (defaults to GMAIL_USER)
# Use a real inbox students can answer, e.g. support@jazeerauniversity.edu.so
CONTACT_REPLY_TO=

# Login identity for Super Admin (can stay admin2@ju.edu.so — not used as mail From)
SUPER_ADMIN_EMAIL=admin2@ju.edu.so

# Strong random string for admin JWT in production (required on Render).
ADMIN_JWT_SECRET=

TABARAAK_SMS_USER=
TABARAAK_SMS_PASSWORD=
